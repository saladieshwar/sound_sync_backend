# Copy to .env and fill in real values. Never commit .env.
APP_NAME=SoundSync API
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://soundsync:your_password@localhost:5432/soundsync

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Optional regex of extra allowed origins. Left empty in development, private-LAN origins on
# port 5173 (e.g. http://192.168.1.20:5173) are allowed for multi-device room testing.
CORS_ORIGIN_REGEX=

# Base URL used when generating shareable room join links.
# For multi-device testing on Wi-Fi use your machine's LAN address, e.g. http://192.168.1.20:5173
FRONTEND_BASE_URL=http://localhost:5173

# Self-hosted media storage (audio + cover images)
MEDIA_ROOT=./media
MEDIA_URL_PREFIX=/media

# Optional: store uploads on Cloudinary instead of MEDIA_ROOT (required on hosts whose disk is
# wiped on restart, e.g. Render's free plan). Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=soundsync
# Without Cloudinary: "local" (MEDIA_ROOT) or "database" (media_files table). Empty means
# "database" when ENVIRONMENT=production and "local" otherwise.
MEDIA_STORAGE=

# Admin upload limits in bytes (50 MB audio, 5 MB cover)
MAX_AUDIO_UPLOAD_BYTES=52428800
MAX_COVER_UPLOAD_BYTES=5242880
